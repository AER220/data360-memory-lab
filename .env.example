# Everything works with this file empty. Copy it to .env only if you want an LLM.
# On Streamlit Community Cloud put the same KEY = "value" lines in App settings > Secrets instead.
# With both keys set you can switch provider live in the sidebar; memory stays exactly the same.

# OPENAI_API_KEY=                    # paid: questions, memories and excerpts are sent to OpenAI
# ANTHROPIC_API_KEY=                 # paid: questions, memories and excerpts are sent to Anthropic

# Optional default provider: openai, anthropic, ollama or offline
# (if unset: OpenAI when its key is set, else Anthropic, else the offline template)
# DATA360_LLM_PROVIDER=openai

# Optional model overrides (you can also type a model name in the sidebar)
# DATA360_OPENAI_MODEL=gpt-4o-mini
# DATA360_ANTHROPIC_MODEL=claude-haiku-5-5

# Free, local: install Ollama, run `ollama pull llama3.2`, then
# DATA360_LLM_PROVIDER=ollama
# DATA360_OLLAMA_MODEL=llama3.2

# DATA360_EMBEDDER=minilm            # needs: pip install sentence-transformers
